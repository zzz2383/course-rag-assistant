# =============================================================================
# 课程资料问答与复习规划助手 - 环境变量示例
# 使用方法：
#   1. 在项目根目录复制本文件为 .env
#      Copy-Item .env.example .env
#   2. 至少填写 DEEPSEEK_API_KEY（或切换 LLM_PROVIDER=qwen 并填写 QWEN_API_KEY）
#   3. .env 已加入 .gitignore，请勿把真实密钥提交到仓库
# =============================================================================

# -----------------------------------------------------------------------------
# 应用
# -----------------------------------------------------------------------------
APP_NAME=课程资料问答与复习规划助手
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# 预留的后端访问密钥；当前本地演示版默认不启用鉴权，保持为空即可。
API_KEY=

# Streamlit 前端的跨域来源，多个值用英文逗号分隔。
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# -----------------------------------------------------------------------------
# 数据目录
# 相对路径会按项目根目录解析；首次启动后端时自动创建。
# -----------------------------------------------------------------------------
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=course_chunks_v1

# 关闭 Chroma 匿名统计（可选，建议保持 false）。
ANONYMIZED_TELEMETRY=false

# -----------------------------------------------------------------------------
# 大模型（LLM）
# LLM_PROVIDER 可选 deepseek 或 qwen。
# 通用配置 LLM_API_KEY / LLM_BASE_URL / LLM_MODEL 留空时，回退到对应供应商配置。
# -----------------------------------------------------------------------------
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60
LLM_MAX_TOKENS=1500
LLM_MAX_RETRIES=2

# DeepSeek（默认供应商）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 通义千问（备用供应商；将 LLM_PROVIDER 改为 qwen 后生效）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 兼容部分使用 DASHSCOPE_* 命名的配置（使用通义时可选）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# -----------------------------------------------------------------------------
# Embedding
# EMBEDDING_MODE=local：本地 sentence-transformers，资料不出本机；需要额外安装
#   sentence-transformers（会附带 torch），首次运行会下载模型。
# EMBEDDING_MODE=api：调用 OpenAI 兼容的 /embeddings 接口，需要填写下面的
#   EMBEDDING_API_KEY 与 EMBEDDING_API_BASE_URL，并同步修改 EMBEDDING_DIM。
# 注意：不同 Embedding 模型的向量维度不能混用；切换模型后应新建 collection
# 并重建索引。
# -----------------------------------------------------------------------------
EMBEDDING_MODE=local
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# 仅 EMBEDDING_MODE=api 时使用
EMBEDDING_API_KEY=
EMBEDDING_API_BASE_URL=
EMBEDDING_API_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# RAG 参数
# -----------------------------------------------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5

# -----------------------------------------------------------------------------
# 上传限制
# -----------------------------------------------------------------------------
MAX_FILE_SIZE_MB=20
MAX_FILES_PER_UPLOAD=10

# -----------------------------------------------------------------------------
# 前端（Streamlit）
# 后端 API 前缀；也可以只写 http://127.0.0.1:8000，前端会自动补 /api。
# 前端只读取这一项配置，不读取任何模型密钥。
# -----------------------------------------------------------------------------
API_BASE_URL=http://127.0.0.1:8000/api
